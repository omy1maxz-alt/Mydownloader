<script>
    var selectedRates = []; // 存放用户选择的分数
    var rateContainers = $('.rate-container'); // 所有rate-container元素
    var submitBtn = $('#lr_submit'); // 提交按钮
    var linerateModal = $('#linerate-modal'); // 线路评分面板
    var linerateBtn = $('#linerate_button'); // 线路评分按钮

    function reset_rate_select() {
        $('.rate-button').removeAttr('disabled');
        $('.rate-button').removeClass('uk-active');
        $('#lr_submit').attr('disabled','');
        selectedRates.splice(0,selectedRates.length);
        rates='';
    }
    
    function isInteger(obj) {
        return typeof obj === 'number' && obj%1 === 0
    }
    function aftersubmitlinerate(res) {
        if (res.code === 1) {
            // Save the array in cookie with name 'linerates'
            Cookies.set('linerate_data', LZString.compressToEncodedURIComponent(JSON.stringify(res.data)), { expires: 3/24,path:'/'});
            linerate_data = res.data;
            UIkit.notification({ message: '打分成功，感谢反馈' });
            // Hide the modal and disable the submit button
            UIkit.modal('#linerate-modal').hide();
            $('#linerate_button').parent().hide();
        } else {
            UIkit.notification({ message: '提交失败:重复打分或频繁操作' });
        }
    }
    function enablelinerate(res) {
        if (guanfang.indexOf(current_selectline)===-1) {
            if (res.code !== 1) {
                $('#linerate_button').parent().hide();
                console.log('enable check: already rated');
            } else {
                console.log('enable check ok');
            }
        } else console.log('guanfang line,no need to rate');
    }

    $(function() {
        //先检查是否已经打分过
        $.ajax({
            url: 'https://kpdata.flixfiend.top/kapi/get_enablelinerate',
            type: 'GET',
            dataType: 'jsonp',
            jsonp: 'callback',
            jsonpCallback: 'enablelinerate',
            data: {
                linename: current_selectline,
                url: location.href,
            },
            success: function(data) {
                console.log('enable check success');
            },
            complete: function (jqXHR,textStatus) {
                console.log('enable check:'+textStatus);
            },
        });

        // 点击分数按钮
        $('.rate-button').on('click', function() {
            var rateButton = $(this);
            var rateCategory = rateButton.closest('.rate-container').find('.rate-category').text();
            var rate = rateButton.data('rate');
            rateButton.addClass('uk-active').siblings().prop('disabled', true); // 选中当前按钮并禁用同组其他按钮
            if (isInteger(rate)) {
                selectedRates[rateCategory] = rate; // 记录用户选择的分数
            }

            checkSubmitEnabled(); // 检查提交按钮是否可用
        });

        // 检查是否可以提交
        function checkSubmitEnabled() {
            var enabled = true;
            rateContainers.each(function() {
                var rateCategory = $(this).find('.rate-category').text();
                if (typeof selectedRates[rateCategory] === 'undefined') { // 检查是否有未打分的维度
                    enabled = false;
                    return false;
                }
            });
            submitBtn.prop('disabled', !enabled); // 根据是否有未打分的维度来控制提交按钮是否可用
        }

        // 点击提交按钮
        submitBtn.on('click', function() {
            if (submitBtn.prop('disabled')) { // 检查提交按钮是否可用
                return;
            }
            $(this).attr('disabled','');
            var rates = Object.values(selectedRates).join(',');
            console.log('rate to submit:'+rates);
            $.ajax({
                url: 'https://kpdata.flixfiend.top/kapi/get_submitlinerate_p',
                type: 'GET',
                dataType: 'jsonp',
                jsonp: 'callback',
                jsonpCallback: 'aftersubmitlinerate',
                statusCode: {
                    400: function() {
                        $(this).removeAttr('disabled');
                        UIkit.notification({message: '<span uk-icon=\\'icon: close\\'></span> 提交失败：' + errorThrown});
                    }
                },
                data: {
                    rate: rates,
                    linename: current_selectline,
                    url: location.href,
                },
                success: function(data) {
                    console.log('submit success:'+data);
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    $(this).removeAttr('disabled');
                    UIkit.notification({message: '<span uk-icon=\\'icon: close\\'></span> 提交失败：' + errorThrown});
                },
                complete: function (jqXHR,textStatus) {
                    console.log('submit status:'+textStatus);
                },
            });
        });
    });
</script>
