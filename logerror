<script>
	var prevkw2 = "";
	var searchbar_show2 = 0;
	var result_show2 = 0;
	var stimer2;
	var protocol2 = window.location.protocol;
	var hostname2 = window.location.hostname;
    var prevsearchtime2 = 0;
	const typelist2 = {
		1:"电影",
		2:"连续剧",
		3:"综艺",
		4:"动漫",
		7:"喜剧片",
		6:"动作片",
		8:"爱情片",
		9:"科幻片",
		10:"恐怖片",
		11:"剧情片",
		12:"战争片",
		13:"国产剧",
		14:"港剧",
		15:"日剧",
		16:"欧美剧",
		20:"台剧",
		21:"泰剧",
		22:"越南剧",
		23:"韩剧",
		26:"考驾照",
		29:"纪录片",
		30:"海外剧",
		31:"卡通片"
	};
	var isSubmitting2 = false;
	var queue2 = "";

	UIkit.util.on('#searchresult2', 'show', function () {
		console.log('result2 show');
		result_show2 = 1;
	});
	UIkit.util.on('#searchresult2', 'hidden', function () {
		console.log('result2 hide');
		result_show2 = 0;
	});

	$('#kw2').click(function() {
		console.log('kw2 clicked');
		setTimeout(function() {
			if (result_show2 == 0) {
				UIkit.dropdown("#searchresult2").show();
			}
		}, 100);

	});

	$("#kw2").on("input", function() {
		var keyword = $(this).val();
		if (keyword !== prevkw2 && checkinput2(keyword) == true) {
			clearTimeout(stimer2);
			stimer2 = setTimeout(function() {
				search2(keyword);
			}, 500);
		}
	});



	function checkinput2(keyword) {
		var trimmedInput = keyword.trim();
		if ((trimmedInput.match(/[\\u4e00-\\u9fa5]/g) || []).length >= 2 || trimmedInput.length >= 5) {
			return true;
		}
		console.log('keyword is short');
		return false;
	}


	function search2(keyword) {
		console.log('start to esearch '+keyword);
		prevkw2 = keyword;
		var timestamp = new Date().getTime();
        if (isSubmitting2 == true && timestamp-prevsearchtime2>10000) isSubmitting2=false;
		if (!isSubmitting2) {
			isSubmitting2 = true;
			queue2 = "";
            prevsearchtime2 = timestamp;
			$.ajax({
				url: "https://kpdata.flixfiend.top/esearch/index?kw=" + keyword + "&ts=" + timestamp,
				dataType: 'jsonp',
                timeout: 8000,
				success: function (data) {
                    if (data.code==1) {
                        console.log('api call success, call jsoutput2');
                        jsoutput2(data);
                        UIkit.dropdown("#searchresult2").show();
                        handle_queue2();
                    } else {
                        console.log('empty search result');
                        handle_queue();
                    }

				},
				error: function (xhr, status, error) {
					// 处理错误
					console.log('api return error');
					console.log(error);
					handle_queue2();
				}
			});
		} else {
			console.log('searching not completed, keyword added to queue');
			queue2 = keyword;
		}
	}

	function handle_queue2() {
		isSubmitting2 = false;
		if (queue2.length > 0) {
			console.log('handle queued keyword '+queue2);
			search2(queue2);
		}
	}

	function jsoutput2(data) {
		jsonstr = CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(data.js));
		//console.log('json:'+jsonstr)
		data = JSON.parse(jsonstr);
		$("#result-body2").empty();
		for (var i = 0; i < data.length; i++) {
			var id = data[i].id;
			var vod_name = data[i].high.vod_name || data[i].data.vod_name;
			var vod_year = data[i].high.vod_year || data[i].data.vod_year;
			var vod_area = data[i].data.vod_area;
			var vod_name_org = data[i].high.vod_name_org || data[i].data.vod_name_org;
			var aka = data[i].high.aka || data[i].data.aka;
			var vod_actor = data[i].high.vod_actor || data[i].data.vod_actor;
			var vod_director = data[i].high.vod_director || data[i].data.vod_director;
			var vod_writer = data[i].high.vod_writer || data[i].data.vod_writer;
			var type_name = typelist2[data[i].data.type_id];
			var vod_pic = data[i].data.vod_imdb_poster || data[i].data.vod_douban_cover || protocol2 + '//' + hostname2 + '/' + data[i].data.vod_pic;
			var vod_url = protocol2 + '//' + hostname2 + '/voddetail/' + id;
			var li = $("<li></li>");
			var card = $("<div class='uk-card uk-card-small uk-child-width-expand uk-card-secondary uk-margin' uk-grid style='margin-left:0px;box-shadow: 0 5px 15px rgba(255, 255, 255, 0.08)'></div>");
			var rdiv=$("<div class='uk-width-4-5' style='margin-top:10px;padding-left:10px'></div>");
			var rbody=$("<div class='uk-card-body' style='padding: 0px 10px 10px 10px;'></div>");
			var title = $("<h6 style='margin-bottom: 5px;'></h3>").html("<a href='" + vod_url + "'>" + vod_name + " (" + vod_year + ")" + "</a>");
			var cover="<div class=\\"uk-card-media-left uk-cover-container\\" style='padding-left:10px'>" +
					"<div tabindex=\\"0\\" class=\\"uk-inline-clip uk-transition-toggle\\"><a href='"+vod_url+"'><img src=\\""+vod_pic+"\\" referrerpolicy=\\"no-referrer\\" alt=\\"\\" style=\\"margin: 10px;\\" class=\\"uk-height-max-medium\\"></a></div>"
					+"</div>";
			var name_org = vod_name_org ? "<p>"+vod_name_org+"</p>" : '';
			var info = $("<p></p>").html((vod_area ? vod_area + " " : "") + type_name);
			rbody.append(title).append(name_org).append(info);
			rdiv.append(rbody);
			card.append(cover).append(rdiv);
			li.append(card);
			$("#result-body2").append(li);
		}
	}
</script>
