<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Theme.MyDownloader" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

    </style>


    <style name="Theme.MyDownloader.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <style name="Theme.MyDownloader.Fullscreen" parent="Theme.MyDownloader.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Solid Dark Popup Menu Style -->
    <style name="GlassyPopupMenu" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <!-- We use the default system solid dark background to guarantee readability -->
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="actionMenuTextColor">@android:color/white</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>