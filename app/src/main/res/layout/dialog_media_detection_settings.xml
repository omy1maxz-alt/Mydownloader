<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <Switch
        android:id="@+id/switch_media_detection"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif-medium"
        android:text="Enable Media Detection"
        android:textColor="@color/md_on_surface"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Automatically inspect network requests and DOM elements for video, audio, and subtitle streams."
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/switch_auto_analyze"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif-medium"
        android:text="Automatic Metadata Analysis"
        android:textColor="@color/md_on_surface"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probe HLS/DASH manifests in the background to detect multi-quality variants and durations."
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

</LinearLayout>
