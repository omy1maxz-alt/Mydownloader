<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Switch
        android:id="@+id/switch_media_detection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Media Detection"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="When enabled, automatically tracks network requests to detect main video media. Disable to save battery or bypass advanced detection."
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingBottom="16dp" />

    <Switch
        android:id="@+id/switch_auto_analyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatic Metadata Analysis"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="When enabled, automatically downloads metadata (like subtitles) for detected media in the background."
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>