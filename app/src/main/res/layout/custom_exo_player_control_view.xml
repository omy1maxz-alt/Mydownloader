<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Media3 controller. Keep the IDs Media3 expects and custom IDs
     consumed by CustomPlayerActivity; only the presentation is reorganized. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/exo_black_opacity_60" />

    <!-- Subtle top overlay for the quick player actions. -->
    <LinearLayout
        android:id="@+id/player_top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_player_overlay_scrim">

        <ImageButton
            android:id="@+id/fab_pip"
            style="@style/ExoStyledControls.Button.Bottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_button_background"
            android:contentDescription="@string/player_pip"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_public" />

        <ImageButton
            android:id="@+id/fab_resize"
            style="@style/ExoStyledControls.Button.Bottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/circle_button_background"
            android:contentDescription="@string/player_resize"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_crop" />

        <ImageButton
            android:id="@+id/fab_bubble"
            style="@style/ExoStyledControls.Button.Bottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/circle_button_background"
            android:contentDescription="@string/player_bubble"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/fab_save"
            style="@style/ExoStyledControls.Button.Bottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/circle_button_background"
            android:contentDescription="@string/player_save_offline"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_download" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/player_track_settings"
            android:src="@android:drawable/ic_menu_preferences"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            app:fabCustomSize="44dp"
            app:maxImageSize="24dp"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Center transport controls retain the native Media3 control IDs. -->
    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        android:layoutDirection="ltr">

        <ImageButton
            android:id="@id/exo_prev"
            style="@style/ExoStyledControls.Button.Center.Previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background" />

        <include layout="@layout/exo_player_control_rewind_button" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_button_background" />

        <include layout="@layout/exo_player_control_ffwd_button" />

        <ImageButton
            android:id="@id/exo_next"
            style="@style/ExoStyledControls.Button.Center.Next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background" />
    </LinearLayout>

    <!-- Time, scrubber and secondary controls occupy the lower safe area. -->
    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_player_overlay_scrim"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@+id/player_time_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position"
                android:textColor="@android:color/white" />

            <TextView
                style="@style/ExoStyledControls.TimeText.Separator"
                android:textColor="#BFFFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration"
                android:textColor="#BFFFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_subtitle"
                style="@style/ExoStyledControls.Button.Bottom.CC"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_button_background"
                android:padding="10dp"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_button_background"
                android:padding="10dp"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@id/exo_fullscreen"
                style="@style/ExoStyledControls.Button.Bottom.FullScreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_button_background"
                android:padding="10dp"
                android:scaleType="centerInside" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            app:bar_height="4dp"
            app:touch_target_height="28dp"
            app:played_color="@color/colorPrimary"
            app:buffered_color="#80FFFFFF"
            app:unplayed_color="#4DFFFFFF"
            app:scrubber_color="@android:color/white" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none"
            android:layoutDirection="ltr">

            <LinearLayout
                android:id="@id/exo_basic_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <ImageButton
                    android:id="@id/exo_vr"
                    style="@style/ExoStyledControls.Button.Bottom.VR"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_button_background"
                    android:padding="8dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@id/exo_shuffle"
                    style="@style/ExoStyledControls.Button.Bottom.Shuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_button_background"
                    android:padding="8dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@id/exo_repeat_toggle"
                    style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_button_background"
                    android:padding="8dp"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_minimal_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

        <ImageButton
            android:id="@id/exo_minimal_fullscreen"
            style="@style/ExoStyledControls.Button.Bottom.FullScreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_button_background"
            android:padding="10dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <View
        android:id="@id/exo_progress_placeholder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/exo_styled_progress_layout_height"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom" />

</merge>
