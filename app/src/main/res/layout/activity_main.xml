<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_surface"
    android:fitsSystemWindows="true">

    <!-- Top Browser App Bar Container -->
    <LinearLayout
        android:id="@+id/appBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:elevation="2dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/md_surface"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/toolbarConstraintLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:animateLayoutChanges="true">

                <ImageButton
                    android:id="@+id/homeButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_home"
                    app:tint="@color/md_on_surface"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/searchBarContainer"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/omnibox_height"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_search_bar_modern"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/rightIconsScroll"
                    app:layout_constraintStart_toEndOf="@+id/homeButton"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/omniboxLeadingIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/md_on_surface_variant" />

                    <EditText
                        android:id="@+id/urlEditTextToolbar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:hint="@string/enter_url"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/md_on_surface"
                        android:textColorHint="@color/md_on_surface_variant"
                        android:textSize="14.5sp" />

                    <ImageButton
                        android:id="@+id/refreshButton"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Refresh"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/md_on_surface_variant" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/rightIconsScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintWidth_max="204dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/backButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="36dp"
                            android:layout_height="40dp"
                            android:visibility="visible"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Back"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/md_on_surface" />

                        <ImageButton
                            android:id="@+id/forwardButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="36dp"
                            android:layout_height="40dp"
                            android:visibility="visible"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Forward"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/md_on_surface" />

                        <ImageButton
                            android:id="@+id/translateButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="36dp"
                            android:layout_height="40dp"
                            android:visibility="visible"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Translate Page"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_translate"
                            app:tint="@color/md_on_surface" />

                        <ImageButton
                            android:id="@+id/aiButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="36dp"
                            android:layout_height="40dp"
                            android:visibility="visible"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Gemini AI"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ai_sparkle"
                            app:tint="@color/md_on_surface" />

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <ImageButton
                                android:id="@+id/fabShowMedia"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Detected media"
                                android:src="@drawable/ic_download"
                                android:visibility="gone"
                                app:tint="@color/colorPrimary"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/mediaCountBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_media_count_badge"
                                android:gravity="center"
                                android:minWidth="18dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/tabButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tabs">

                            <TextView
                                android:id="@+id/tabCount"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:background="@drawable/tab_count_background"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:text="1"
                                android:textColor="@color/md_on_surface"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                tools:ignore="SmallSp" />
                        </FrameLayout>

                        <ImageButton
                            android:id="@+id/overflowMenuButton"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="More options"
                            android:src="@drawable/ic_more_vert"
                            app:tint="@color/md_on_surface" />

                    </LinearLayout>
                </HorizontalScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

        <View
            android:id="@+id/toolbarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_outline_variant" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/colorPrimary"
            android:progressBackgroundTint="@color/md_surface_variant"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Main Browser & Start Page Content Area -->
    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/md_surface">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Redesigned Modern Start Page Container -->
        <LinearLayout
            android:id="@+id/startPageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/md_surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:visibility="visible">

            <!-- Hero Brand & Quick Access Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_surface_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_badge_pill">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_download"
                                app:tint="@color/md_on_primary_container" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/start_page_headline"
                                android:textColor="@color/md_on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/start_page_subhead"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Action Pills Row -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/quickActionDownloads"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="38dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="14dp"
                                android:text="Downloads"
                                android:textSize="12.5sp"
                                app:icon="@drawable/ic_download"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/quickActionHistory"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="38dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="14dp"
                                android:text="History"
                                android:textSize="12.5sp"
                                app:icon="@drawable/ic_history"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/quickActionScripts"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="38dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="14dp"
                                android:text="User Scripts"
                                android:textSize="12.5sp"
                                app:icon="@drawable/ic_code"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/quickActionAi"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="38dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="14dp"
                                android:text="Ask Gemini"
                                android:textSize="12.5sp"
                                app:icon="@drawable/ic_ai_sparkle"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bookmarks Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/bookmarks_section_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddManualLinkHome"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+ Add Link"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmarkRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp"
                    android:visibility="visible" />

                <!-- Empty State for Bookmarks -->
                <LinearLayout
                    android:id="@+id/bookmarkEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_container">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bookmark_border"
                            app:tint="@color/md_on_surface_variant" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/bookmarks_empty_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxWidth="280dp"
                        android:text="@string/bookmarks_empty_subtitle"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Redesigned Pill-Shaped Floating Media Detector Banner -->
        <LinearLayout
            android:id="@+id/floatingDetectorUI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_floating_pill"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_button_background">

                <ImageView
                    android:id="@+id/btnDetectorDownload"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Download"
                    android:src="@drawable/ic_download"
                    app:tint="#66DDA0" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDetectorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="200dp"
                    android:text="Media Detected"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetectorState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to inspect or download"
                    android:textColor="#BFC9C5"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDetectorClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                app:tint="#DFE4E2" />

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

</LinearLayout>
