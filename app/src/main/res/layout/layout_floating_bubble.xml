<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD000000"
        android:elevation="4dp"
        android:padding="12dp"
        android:gravity="center">

        <!-- Collapsed view -->
        <TextView
            android:id="@+id/txt_bubble_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 0 ]"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/img_bubble_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:layout_marginTop="4dp" />

        <!-- Expanded view -->
        <LinearLayout
            android:id="@+id/expanded_details"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File(s) detected!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_empty_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Information!\nNo file to download\n1) If the Video player provides multiple video source and video is not captured, please select different video source in the player\n2) You can change video resolution in video player (if available) for high/low quality video\n3) Use Preview or Stream menu option if the size is shown as unknown\nNote: File size prefixed by ~ represents guessed file size and will differ with actual size (sometimes by a large margin)"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:visibility="visible"
                android:layout_marginBottom="8dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/list_media_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- Bottom controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:weightSum="3">
                <Button
                    android:id="@+id/btn_clear_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CLEAR ALL"
                    android:background="@android:color/transparent"
                    android:textColor="#BA68C8"/>
                <Button
                    android:id="@+id/btn_sort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SORT"
                    android:background="@android:color/transparent"
                    android:textColor="#BA68C8"/>
                <Button
                    android:id="@+id/btn_close_expanded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CLOSE"
                    android:background="@android:color/transparent"
                    android:textColor="#BA68C8"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_close_bubble"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="#80000000"
        android:elevation="6dp"/>

</FrameLayout>