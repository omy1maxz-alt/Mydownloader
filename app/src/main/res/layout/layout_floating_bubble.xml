<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_pill"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center">

        <!-- Collapsed view -->
        <TextView
            android:id="@+id/txt_bubble_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="0"
            android:textColor="#7ADACB"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/img_bubble_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="#FFFFFF"
            android:layout_marginTop="4dp" />

        <!-- Expanded view -->
        <LinearLayout
            android:id="@+id/expanded_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDIA DETECTOR"
                android:textColor="#9CF2E3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_detector_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● NO MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txt_detector_details"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Candidates: 0
Verified: 0"
                android:textColor="#DFE4E2"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_open_player"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Open Player"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_close_bubble"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF"
        android:background="@drawable/circle_button_background"
        android:elevation="8dp" />

</FrameLayout>
